{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "messhall contracts",
  "$defs": {
    "Agreement": {
      "type": "object",
      "properties": {
        "confirmed": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}$",
            "description": "Lowercase letters, digits and dashes, 1 to 40 chars."
          },
          "description": "The named members who confirmed so far, in the order they did."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "When it was proposed."
        },
        "decided_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "ISO 8601 time in UTC."
            },
            {
              "type": "null"
            }
          ],
          "description": "When it was settled, rejected or replaced, null while open."
        },
        "id": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Agreement id: the id of the proposer's own line that carries it."
        },
        "proposer": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$",
          "description": "The seat that proposed it."
        },
        "rejected_by": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,40}$",
              "description": "Lowercase letters, digits and dashes, 1 to 40 chars."
            },
            {
              "type": "null"
            }
          ],
          "description": "Who rejected it, null unless rejected."
        },
        "replaces": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "description": "The agreement this one replaces, null when new."
        },
        "room": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$",
          "description": "Room the agreement is in."
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "settled",
            "rejected",
            "replaced"
          ],
          "description": "open until every named member confirms, settled after, rejected when a named member says no, replaced by a newer proposal."
        },
        "text": {
          "type": "string",
          "description": "What is agreed, one line. Untrusted text from the agent."
        },
        "why": {
          "description": "Why it was rejected, one line, null unless rejected. Untrusted text from the agent.",
          "type": [
            "string",
            "null"
          ]
        },
        "with": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}$",
            "description": "Lowercase letters, digits and dashes, 1 to 40 chars."
          },
          "description": "The members who must confirm it, in the order the proposer named them."
        }
      },
      "required": [
        "confirmed",
        "created_at",
        "decided_at",
        "id",
        "proposer",
        "rejected_by",
        "replaces",
        "room",
        "state",
        "text",
        "why",
        "with"
      ],
      "additionalProperties": false
    },
    "AgreementEvent": {
      "type": "object",
      "properties": {
        "agreement": {
          "description": "The agreement after the change.",
          "$ref": "#/$defs/Agreement"
        },
        "room": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$",
          "description": "Room name."
        },
        "type": {
          "type": "string",
          "const": "agreement",
          "description": "An agent proposed an agreement, or it was confirmed, settled, rejected or replaced."
        }
      },
      "required": [
        "agreement",
        "room",
        "type"
      ],
      "additionalProperties": false
    },
    "AnswerResult": {
      "type": "object",
      "properties": {
        "message": {
          "description": "The human line that carries the answer and rings the asker.",
          "$ref": "#/$defs/Message"
        },
        "question": {
          "description": "The question as answered.",
          "$ref": "#/$defs/Question"
        }
      },
      "required": [
        "message",
        "question"
      ],
      "additionalProperties": false
    },
    "Approval": {
      "type": "object",
      "properties": {
        "answered_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "ISO 8601 time in UTC."
            },
            {
              "type": "null"
            }
          ],
          "description": "When it was answered or expired, null while pending."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "When the agent asked."
        },
        "description": {
          "type": "string",
          "description": "The agent's own summary of the call. Untrusted text, never the command itself."
        },
        "id": {
          "type": "string",
          "description": "Approval id. The human answers this exact id."
        },
        "input_preview": {
          "type": "string",
          "description": "The tool arguments as JSON shaped text, like the command for Bash. Untrusted."
        },
        "member": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$",
          "description": "The seat whose agent asks."
        },
        "room": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$",
          "description": "Room the seat is in."
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "allowed",
            "denied",
            "expired"
          ],
          "description": "pending until the human answers, allowed or denied after, expired when nobody answered in time."
        },
        "tool": {
          "type": "string",
          "description": "The tool the agent wants to use, like Bash or Write."
        }
      },
      "required": [
        "answered_at",
        "created_at",
        "description",
        "id",
        "input_preview",
        "member",
        "room",
        "state",
        "tool"
      ],
      "additionalProperties": false
    },
    "ApprovalEvent": {
      "type": "object",
      "properties": {
        "approval": {
          "description": "The approval after the change.",
          "$ref": "#/$defs/Approval"
        },
        "room": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$",
          "description": "Room name."
        },
        "type": {
          "type": "string",
          "const": "approval",
          "description": "An agent asked to use a tool, or its ask was answered or expired."
        }
      },
      "required": [
        "approval",
        "room",
        "type"
      ],
      "additionalProperties": false
    },
    "ApprovalResult": {
      "type": "object",
      "properties": {
        "approvals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Approval"
          },
          "description": "The approval as answered, one per room its seat is in."
        }
      },
      "required": [
        "approvals"
      ],
      "additionalProperties": false
    },
    "Build": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "The git commit the code was built from, 40 hex chars."
        },
        "committed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "When that commit was made, ISO 8601 in UTC. Later means newer code."
        }
      },
      "required": [
        "commit",
        "committed_at"
      ],
      "additionalProperties": false
    },
    "BusEvent": {
      "oneOf": [
        {
          "$ref": "#/$defs/MessageEvent"
        },
        {
          "$ref": "#/$defs/MemberEvent"
        },
        {
          "$ref": "#/$defs/PresenceEvent"
        },
        {
          "$ref": "#/$defs/RoomEvent"
        },
        {
          "$ref": "#/$defs/ApprovalEvent"
        },
        {
          "$ref": "#/$defs/QuestionEvent"
        },
        {
          "$ref": "#/$defs/AgreementEvent"
        }
      ],
      "description": "One change in the room store."
    },
    "CloseResult": {
      "type": "object",
      "properties": {
        "room": {
          "description": "The room, closed until the human reopens it.",
          "$ref": "#/$defs/Room"
        }
      },
      "required": [
        "room"
      ],
      "additionalProperties": false
    },
    "FeedError": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "description": "What went wrong, in plain words."
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "Health": {
      "type": "object",
      "properties": {
        "build": {
          "description": "The code the daemon started on, null when it is not a git checkout. Missing means a daemon too old to say.",
          "anyOf": [
            {
              "$ref": "#/$defs/Build"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract_version": {
          "description": "The feed contract the daemon speaks. Missing means a daemon too old to say.",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "live_members": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Agents in a room right now that are not away."
        },
        "ok": {
          "type": "boolean",
          "const": true,
          "description": "Always true when the daemon answers."
        },
        "rooms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Rooms the daemon holds, open or closed."
        },
        "uptime_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Whole seconds since the daemon started."
        },
        "version": {
          "type": "string",
          "description": "The messhall version the daemon runs."
        }
      },
      "required": [
        "live_members",
        "ok",
        "rooms",
        "uptime_s",
        "version"
      ],
      "additionalProperties": false
    },
    "History": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          },
          "description": "One page of a room, oldest first."
        }
      },
      "required": [
        "messages"
      ],
      "additionalProperties": false
    },
    "HumanAnswer": {
      "type": "object",
      "properties": {
        "option": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Index of the option the human picks, from 0."
        }
      },
      "required": [
        "option"
      ],
      "additionalProperties": false
    },
    "HumanApproval": {
      "type": "object",
      "properties": {
        "behavior": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ],
          "description": "allow lets the one tool call run, deny refuses it."
        }
      },
      "required": [
        "behavior"
      ],
      "additionalProperties": false
    },
    "HumanPost": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "What the human says, 1 to 4,000 chars."
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "HumanPostResult": {
      "type": "object",
      "properties": {
        "message": {
          "description": "The message as posted, from human.",
          "$ref": "#/$defs/Message"
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "HumanRole": {
      "type": "object",
      "properties": {
        "instructions": {
          "description": "What the member should do in this role, 1 to 4,000 chars. Left out clears any earlier ones.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$",
          "description": "The role to give the member."
        }
      },
      "required": [
        "role"
      ],
      "additionalProperties": false
    },
    "HumanRoleResult": {
      "type": "object",
      "properties": {
        "member": {
          "description": "The member with its new role.",
          "$ref": "#/$defs/Member"
        },
        "message": {
          "description": "The line from human that mentions the member, so it reads its role.",
          "$ref": "#/$defs/Message"
        }
      },
      "required": [
        "member",
        "message"
      ],
      "additionalProperties": false
    },
    "Member": {
      "type": "object",
      "properties": {
        "client_label": {
          "description": "Short agent type from the client name, like claude or opencode, or its first word when unknown. Null for the human seat or a member with no client.",
          "type": [
            "string",
            "null"
          ]
        },
        "client_name": {
          "description": "The clientInfo.name the agent sent at initialize, as sent. Self-declared, null when none.",
          "type": [
            "string",
            "null"
          ]
        },
        "client_version": {
          "description": "The clientInfo.version the agent sent at initialize, null when none.",
          "type": [
            "string",
            "null"
          ]
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Id of the last message this member has read."
        },
        "done": {
          "type": "boolean",
          "description": "True after the member posted done, until its next post."
        },
        "joined_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "When the member first joined."
        },
        "kind": {
          "description": "Which agent runs the member.",
          "$ref": "#/$defs/MemberKind"
        },
        "last_seen_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "When the member last made a call."
        },
        "left_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "ISO 8601 time in UTC."
            },
            {
              "type": "null"
            }
          ],
          "description": "When the member left, null while it is in the room."
        },
        "muted": {
          "type": "boolean",
          "description": "True while the human or an orchestrator has muted the member: it reads, but its posts are refused."
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$",
          "description": "Role name in the room."
        },
        "presence": {
          "description": "What the member is doing now.",
          "$ref": "#/$defs/Presence"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$",
          "description": "What the member does here. Starts unassigned, orchestrator for a member named orchestrator."
        },
        "room_id": {
          "type": "string",
          "description": "Room id."
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ],
          "description": "What the member is doing now, one line it set itself, like tests green. Null when unset."
        },
        "status_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "description": "ISO 8601 time in UTC."
            },
            {
              "type": "null"
            }
          ],
          "description": "When the member set its status, null when unset."
        }
      },
      "required": [
        "client_label",
        "client_name",
        "client_version",
        "cursor",
        "done",
        "joined_at",
        "kind",
        "last_seen_at",
        "left_at",
        "muted",
        "name",
        "presence",
        "role",
        "room_id",
        "status",
        "status_at"
      ],
      "additionalProperties": false
    },
    "MemberEvent": {
      "type": "object",
      "properties": {
        "change": {
          "type": "string",
          "enum": [
            "invited",
            "joined",
            "left",
            "muted",
            "reconnected",
            "removed",
            "role",
            "status",
            "unmuted"
          ],
          "description": "invited when its seat was made ahead, joined, left, reconnected, removed when it left 5 minutes ago, its invite went unused or the human or an orchestrator kicked it, role when its role was set, status when it set its status, or muted and unmuted."
        },
        "member": {
          "description": "The member after the change.",
          "$ref": "#/$defs/Member"
        },
        "room": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$",
          "description": "Room name."
        },
        "type": {
          "type": "string",
          "const": "member",
          "description": "A member was invited, came, went, dropped out, got a role, set its status or was muted."
        }
      },
      "required": [
        "change",
        "member",
        "room",
        "type"
      ],
      "additionalProperties": false
    },
    "MemberKind": {
      "type": "string",
      "enum": [
        "claude",
        "codex",
        "other",
        "human"
      ],
      "description": "Which agent runs the member: claude, codex, other or human."
    },
    "MuteResult": {
      "type": "object",
      "properties": {
        "member": {
          "description": "The member after the mute or unmute.",
          "$ref": "#/$defs/Member"
        }
      },
      "required": [
        "member"
      ],
      "additionalProperties": false
    },
    "Message": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "description": "When it was posted."
        },
        "from": {
          "type": "string",
          "description": "Member name, or messhall for daemon lines."
        },
        "from_client_label": {
          "description": "The sender's agent type when it posted, like claude or script. Null for the human, daemon lines or a sender with no client.",
          "type": [
            "string",
            "null"
          ]
        },
        "from_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemberKind"
            },
            {
